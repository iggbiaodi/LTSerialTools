<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <Property name="autoSaveFileSize">10MB</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %c{1.}:%L - %msg%n" charset="UTF-8"/>
        </Console>

        <RollingFile name="RollingFile" fileName="logs/app.log"
                     filePattern="logs/$${date:yyyy-MM}/app-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5p %c{1.}:%L - %msg%n" charset="UTF-8"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10MB"/>
                <TimeBasedTriggeringPolicy/>
            </Policies>
            <DefaultRolloverStrategy>
                <Delete basePath="logs/" maxDepth="2">
                    <IfFileName glob="*/app-*.log.gz"/>
                    <IfLastModified age="7d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- 自动保存串口数据的 RollingFile，大小可通过系统属性动态配置 -->
        <RollingFile name="AutoSaveFile" fileName="logs/auto-save/serial-data.log"
                     filePattern="logs/auto-save/serial-data-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} - %msg%n" charset="UTF-8"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="${sys:autoSaveFileSize:-10MB}"/>
                <TimeBasedTriggeringPolicy/>
            </Policies>
            <DefaultRolloverStrategy max="100">
                <Delete basePath="logs/auto-save/" maxDepth="2">
                    <IfFileName glob="*/serial-data-*.log.gz"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Root level="warn">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Root>

        <Logger name="org.flywaydb" level="warn" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <!-- 自动保存串口数据的Logger，additivity="false" 避免输出到控制台和其他appender -->
        <Logger name="AutoSaveLogger" level="info" additivity="false">
            <AppenderRef ref="AutoSaveFile"/>
        </Logger>
    </Loggers>
</Configuration>